# Build de demonstracao para o cliente (`npm run build:demo`): abre a galeria do redesign com dados
# ficticios. Config do Firebase PROPOSITALMENTE falsa — nada de chave real no bundle e nenhuma
# leitura/escrita chega ao projeto de producao.
VITE_DEMO_PREVIEW=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-level.invalid
VITE_FIREBASE_PROJECT_ID=demo-level
VITE_FIREBASE_STORAGE_BUCKET=demo-level.invalid
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_FIREBASE_FUNCTIONS_REGION=southamerica-east1
VITE_USE_FIREBASE_EMULATORS=false
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=
