rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.role is string
        ? request.auth.token.role
        : '';
    }

    function academyId() {
      return signedIn() && request.auth.token.academyId is string
        ? request.auth.token.academyId
        : '';
    }

    function isSuperAdmin() {
      return signedIn() && role() == 'superadmin';
    }

    function isAdmin() {
      return signedIn() && (role() == 'admin' || role() == 'professor');
    }

    function isProfessor() {
      return signedIn() && role() == 'professor';
    }

    function sameAcademy(targetAcademyId) {
      return isSuperAdmin() || (signedIn() && academyId() == targetAcademyId);
    }

    function isAcademyStaff(targetAcademyId) {
      return sameAcademy(targetAcademyId) && (isAdmin() || isProfessor() || isSuperAdmin());
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /academies/{academyDocId}/learning/lessons/{allPaths=**} {
      allow read: if signedIn() && (isSuperAdmin() || academyDocId == 'shared' || academyId() == academyDocId);
      allow write: if isSuperAdmin();
    }

    match /academies/{academyDocId}/{allPaths=**} {
      allow read: if sameAcademy(academyDocId);
      allow write: if isAcademyStaff(academyDocId) && !allPaths.matches('learning/lessons/.*');
    }

    match /users/{userId}/{allPaths=**} {
      // Fotos de perfil sao semi-publicas dentro do app (visivel para colegas autenticados)
      allow read: if signedIn();
      // Escrita restrita ao proprio usuario ou superadmin; a equipe da unidade nao altera arquivos de outras academias
      allow write: if isSelf(userId) || isSuperAdmin();
    }
  }
}
