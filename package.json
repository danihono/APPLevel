{
  "name": "level-jj---premium-jiu-jitsu-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy:hosting": "npm run build && firebase deploy --only hosting --project applevel-c5e73 --non-interactive",
    "functions:build": "npm --prefix functions run build",
    "firebase:fix-invokers": "node scripts/fixFunctionInvokers.cjs",
    "firebase:bootstrap:tenant": "npm --prefix functions run bootstrap:tenant --",
    "firebase:reset:student": "npm --prefix functions run reset:student --",
    "firebase:fix:class-professors": "npm --prefix functions run fix:class-professors --",
    "firebase:inspect:duplicate-users": "npm --prefix functions run inspect:duplicate-users --",
    "firebase:emulators": "firebase emulators:start --project applevel-c5e73",
    "firebase:deploy": "firebase deploy --project applevel-c5e73 && npm run firebase:fix-invokers",
    "deploy:indexes": "firebase deploy --only firestore:indexes --project applevel-c5e73 --non-interactive",
    "deploy:rules": "firebase deploy --only firestore:rules,storage --project applevel-c5e73 --non-interactive"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@google/genai": "^1.41.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "firebase": "^12.11.0",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.571.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-qr-code": "^2.0.18"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
