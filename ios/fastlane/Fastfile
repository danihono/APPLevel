# Pipeline iOS do LEVEL JIUJITSU.
#
# Roda inteiro em um runner macOS na nuvem (GitHub Actions) — nao e preciso ter
# um Mac. A autenticacao com a Apple usa uma App Store Connect API Key (.p8),
# que dispensa senha e 2FA.
#
# Lanes:
#   bundle exec fastlane bootstrap  -> cria App ID, app na App Store Connect e assinaturas (1x)
#   bundle exec fastlane beta       -> compila e envia a build para o TestFlight
#   bundle exec fastlane release    -> envia a build mais recente para revisao da App Store

default_platform(:ios)

XCODEPROJ      = "App/App.xcodeproj"
SCHEME         = "App"
APP_IDENTIFIER = ENV["APP_IDENTIFIER"] || "com.leveljiujitsu.app"
APP_NAME       = ENV["APP_NAME"] || "LEVEL JIUJITSU"

platform :ios do
  before_all do
    # Cria uma keychain temporaria no runner para guardar o certificado.
    setup_ci if is_ci
  end

  # Autenticacao via App Store Connect API Key (.p8 em base64 nos secrets).
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc "Passo unico: registra o App ID, cria o app na App Store Connect e gera certificado + profile"
  lane :bootstrap do
    key = asc_api_key

    # `produce` nao aceita o parametro `api_key`: ele usa o token que o
    # `app_store_connect_api_key` ja registrou no Spaceship global.
    begin
      produce(
        app_identifier: APP_IDENTIFIER,
        app_name: APP_NAME,
        language: "Brazilian Portuguese",
        app_version: ENV["MARKETING_VERSION"] || "1.0.0",
        sku: ENV["APP_SKU"] || "leveljiujitsu-ios",
        team_id: ENV["ASC_TEAM_ID"],
        company_name: ENV["COMPANY_NAME"]
      )
    rescue => e
      UI.important("produce nao concluiu: #{e.message}")
      UI.important("Se o app ja existe na App Store Connect isso e esperado.")
      UI.important("Seguindo para a criacao das assinaturas para ver se ela passa.")
    end

    # readonly: false -> cria o certificado de distribuicao e o provisioning
    # profile na conta Apple e guarda criptografados no repo do match.
    match(
      api_key: key,
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      readonly: false
    )

    UI.success("Bootstrap concluido. Agora rode a lane `beta`.")
  end

  desc "Compila o app e envia para o TestFlight"
  lane :beta do
    key = asc_api_key
    build_ipa(api_key: key)

    upload_to_testflight(
      api_key: key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )

    UI.success("Build enviada. Ela aparece no TestFlight apos o processamento da Apple (10-30 min).")
  end

  desc "Envia a build mais recente do TestFlight para a revisao da App Store"
  lane :release do
    key = asc_api_key

    upload_to_app_store(
      api_key: key,
      app_identifier: APP_IDENTIFIER,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end

  # ---------------------------------------------------------------------------

  desc "Assina e compila o .ipa (uso interno)"
  private_lane :build_ipa do |options|
    key = options[:api_key]

    match(
      api_key: key,
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      readonly: ENV["MATCH_READONLY"] != "false"
    )

    profile_name = ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-name"]
    team_id      = ENV["ASC_TEAM_ID"] || ENV["sigh_#{APP_IDENTIFIER}_appstore_team-id"]
    UI.user_error!("Provisioning profile nao encontrado. Rode a lane `bootstrap` primeiro.") if profile_name.to_s.empty?

    # Versao visivel na loja. Sobrescreva com o secret/variavel MARKETING_VERSION
    # a cada nova versao publicada (1.0.0 -> 1.1.0 -> ...).
    marketing_version = ENV["MARKETING_VERSION"] || "1.0.0"

    build_number = next_build_number(api_key: key)
    UI.message("Versao #{marketing_version} (build #{build_number})")

    xcargs = [
      "CURRENT_PROJECT_VERSION=#{build_number}",
      "MARKETING_VERSION=#{marketing_version}",
      "CODE_SIGN_STYLE=Manual",
      "DEVELOPMENT_TEAM=#{team_id}",
      "PROVISIONING_PROFILE_SPECIFIER=\"#{profile_name}\"",
      "CODE_SIGN_IDENTITY=\"Apple Distribution\""
    ].join(" ")

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "LEVEL-JIUJITSU.ipa",
      clean: true,
      silent: false,
      xcargs: xcargs,
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: { APP_IDENTIFIER => profile_name }
      }
    )
  end

  desc "Proximo numero de build, olhando o que ja existe na Apple"
  private_lane :next_build_number do |options|
    latest = begin
      latest_testflight_build_number(
        api_key: options[:api_key],
        app_identifier: APP_IDENTIFIER,
        initial_build_number: 0
      ).to_i
    rescue => e
      UI.important("Nao foi possivel ler a ultima build na Apple (#{e.message}); comecando do zero.")
      0
    end

    # Em caso de empate com o contador do CI, usa o maior dos dois.
    [latest + 1, ENV["GITHUB_RUN_NUMBER"].to_i].max
  end
end
