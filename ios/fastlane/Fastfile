# Pipeline iOS do LEVEL JIUJITSU.
#
# Roda inteiro em um runner macOS na nuvem (GitHub Actions) — nao e preciso ter
# um Mac. A autenticacao com a Apple usa uma App Store Connect API Key (.p8),
# que dispensa senha e 2FA.
#
# Lanes:
#   bundle exec fastlane bootstrap  -> gera certificado e provisioning profile (1x)
#   bundle exec fastlane beta       -> compila e envia a build para o TestFlight
#   bundle exec fastlane release    -> envia a build mais recente para revisao da App Store

default_platform(:ios)

XCODEPROJ      = "App/App.xcodeproj"
SCHEME         = "App"
APP_IDENTIFIER = ENV["APP_IDENTIFIER"] || "com.leveljiujitsu.app"
APP_NAME       = ENV["APP_NAME"] || "LEVEL JIUJITSU"

# Versao visivel na loja. Vem do campo do workflow; num disparo por tag
# `ios-v1.0.1`, deriva do nome da tag. Sem valor nao ha palpite seguro: a Apple
# fecha cada versao ao publicar, entao repetir a anterior sempre falha.
def resolve_marketing_version
  informada = ENV["MARKETING_VERSION"].to_s.strip
  return informada unless informada.empty?

  tag = ENV["GITHUB_REF_NAME"].to_s.strip
  return tag.sub(/\Aios-v/, "") if tag.start_with?("ios-v")

  UI.user_error!(
    'Informe a versao no campo "Versao visivel na loja" ao disparar o workflow. ' \
    'Ela precisa ser maior que a ja publicada na App Store.'
  )
end

platform :ios do
  before_all do
    # Cria uma keychain temporaria no runner para guardar o certificado.
    setup_ci if is_ci
  end

  # Autenticacao via App Store Connect API Key (.p8 em base64 nos secrets).
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc "Passo unico: gera o certificado de distribuicao e o provisioning profile"
  lane :bootstrap do
    key = asc_api_key

    # O App ID e o registro do app na App Store Connect sao criados UMA VEZ,
    # manualmente, nos sites da Apple (ver APPLE_STORE.md). A acao `produce` do
    # fastlane nao serve aqui: ela ainda exige Apple ID + senha e nao aceita a
    # App Store Connect API Key, o que e incompativel com CI sem 2FA.

    # readonly: false -> cria o certificado de distribuicao e o provisioning
    # profile na conta Apple e guarda criptografados no repo do match.
    match(
      api_key: key,
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      readonly: false
    )

    UI.success("Bootstrap concluido. Agora rode a lane `beta`.")
  end

  desc "Compila o app e envia para o TestFlight"
  lane :beta do
    key = asc_api_key
    build_ipa(api_key: key)

    upload_to_testflight(
      api_key: key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )

    UI.success("Build enviada. Ela aparece no TestFlight apos o processamento da Apple (10-30 min).")
  end

  desc "Envia a build mais recente do TestFlight para a revisao da App Store"
  lane :release do
    key = asc_api_key

    upload_to_app_store(
      api_key: key,
      app_identifier: APP_IDENTIFIER,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end

  # ---------------------------------------------------------------------------

  desc "Assina e compila o .ipa (uso interno)"
  private_lane :build_ipa do |options|
    key = options[:api_key]

    match(
      api_key: key,
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      readonly: ENV["MATCH_READONLY"] != "false"
    )

    profile_name = ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-name"]
    team_id      = ENV["ASC_TEAM_ID"] || ENV["sigh_#{APP_IDENTIFIER}_appstore_team-id"]
    UI.user_error!("Provisioning profile nao encontrado. Rode a lane `bootstrap` primeiro.") if profile_name.to_s.empty?

    marketing_version = resolve_marketing_version

    build_number = next_build_number(api_key: key)

    # A Apple so recusa versao repetida no fim do upload, depois de compilar e assinar; barrar
    # aqui economiza alguns minutos por tentativa. Mas o que fecha o train e a versao
    # PUBLICADA, nao a que ja foi ao TestFlight: uma versao ainda nao publicada (em preparacao,
    # rejeitada pela Apple ou retirada pelo desenvolvedor) aceita build nova com o mesmo numero,
    # desde que o build number suba — e disso o `next_build_number` ja cuida.
    publicada = begin
      app_store_build_number(
        api_key: key,
        app_identifier: APP_IDENTIFIER,
        live: true
      )
      lane_context[SharedValues::LATEST_VERSION].to_s.strip
    rescue => e
      # App sem nenhuma versao publicada, ou falha de rede: segue sem a checagem, como era antes
      # de ela existir. Se a versao estiver mesmo fechada, a Apple recusa no upload.
      UI.important("Nao foi possivel ler a versao publicada na App Store (#{e.message}); seguindo sem a checagem.")
      ""
    end

    unless publicada.empty?
      if Gem::Version.new(marketing_version) <= Gem::Version.new(publicada)
        UI.user_error!(
          "A versao #{marketing_version} nao e maior que a #{publicada}, ja publicada na " \
          "App Store. Esse numero esta fechado para novas builds; rode de novo informando um " \
          "maior (ex.: #{publicada.split('.').tap { |p| p[-1] = (p[-1].to_i + 1).to_s }.join('.')})."
        )
      end
    end

    # Reenvio para uma versao que ja tem build no TestFlight mas ainda nao foi publicada: e o
    # fluxo normal de corrigir uma submissao retirada. Avisa, nao barra.
    no_testflight = lane_context[SharedValues::LATEST_TESTFLIGHT_VERSION].to_s.strip
    if !no_testflight.empty? && Gem::Version.new(marketing_version) <= Gem::Version.new(no_testflight)
      UI.important(
        "A versao #{marketing_version} ja tem build no TestFlight e ainda nao foi publicada: " \
        "esta vai entrar como build #{build_number} na mesma versao."
      )
    end

    UI.message("Versao #{marketing_version} (build #{build_number})")

    xcargs = [
      "CURRENT_PROJECT_VERSION=#{build_number}",
      "MARKETING_VERSION=#{marketing_version}",
      "CODE_SIGN_STYLE=Manual",
      "DEVELOPMENT_TEAM=#{team_id}",
      "PROVISIONING_PROFILE_SPECIFIER=\"#{profile_name}\"",
      "CODE_SIGN_IDENTITY=\"Apple Distribution\""
    ].join(" ")

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "LEVEL-JIUJITSU.ipa",
      clean: true,
      silent: false,
      xcargs: xcargs,
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: { APP_IDENTIFIER => profile_name }
      }
    )
  end

  desc "Proximo numero de build, olhando o que ja existe na Apple"
  private_lane :next_build_number do |options|
    latest = begin
      latest_testflight_build_number(
        api_key: options[:api_key],
        app_identifier: APP_IDENTIFIER,
        initial_build_number: 0
      ).to_i
    rescue => e
      UI.important("Nao foi possivel ler a ultima build na Apple (#{e.message}); comecando do zero.")
      0
    end

    # Em caso de empate com o contador do CI, usa o maior dos dois.
    [latest + 1, ENV["GITHUB_RUN_NUMBER"].to_i].max
  end
end
