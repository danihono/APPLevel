rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.role is string
        ? request.auth.token.role
        : '';
    }

    function academyId() {
      return signedIn() && request.auth.token.academyId is string
        ? request.auth.token.academyId
        : '';
    }

    function isSuperAdmin() {
      return signedIn() && role() == 'superadmin';
    }

    function isAdmin() {
      return signedIn() && (role() == 'admin' || role() == 'professor');
    }

    function isProfessor() {
      return signedIn() && role() == 'professor';
    }

    function isApprover() {
      return signedIn() && (role() == 'professor' || role() == 'admin' || role() == 'superadmin');
    }

    function isStudent() {
      return signedIn() && role() == 'student';
    }

    function sameAcademy(targetAcademyId) {
      return isSuperAdmin() || (signedIn() && academyId() != '' && academyId() == targetAcademyId);
    }

    function isAcademyStaff(targetAcademyId) {
      return sameAcademy(targetAcademyId) && (isProfessor() || isAdmin() || isSuperAdmin());
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function notificationEditableKeys() {
      return ['readAt', 'status', 'updatedAt'];
    }

    match /users/{userId} {
      allow read: if isSuperAdmin() || isSelf(userId) || isAcademyStaff(resource.data.academyId);

      allow create: if isSuperAdmin()
        || (
          isAdmin()
          && request.resource.data.role != 'superadmin'
          && request.resource.data.role != 'admin'
          && sameAcademy(request.resource.data.academyId)
        );

      // Staff edita perfil pelo SDK cliente, mas faixa/grau/progressao/identidade so mudam via
      // Cloud Functions (Admin SDK ignora estas regras). Bloquear a escrita direta desses campos
      // fecha o bypass do gate de graduacao e da contabilidade marco+bonus.
      allow update: if isAcademyStaff(resource.data.academyId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'belt', 'stripes', 'grade',
          'attendanceCount', 'attendanceCountBonus', 'attendanceCountAtBeltStart',
          'lastGradeApprovalAt', 'lastStripeDateOverride', 'lastGraduationDateOverride',
          'role', 'academyId', 'memberships',
          'nextStripeAttendanceTarget', 'nextBeltAttendanceTarget',
          'currentStripeProgress', 'classesToNextStripe',
          'currentBeltProgress', 'totalClassesToNextBelt',
          'rankingPoints', 'missionPoints', 'competitionPoints', 'beltPromotions'
        ]);

      allow delete: if isSuperAdmin() || (isAdmin() && sameAcademy(resource.data.academyId));
    }

    match /academies/{academyDocId} {
      allow read: if signedIn();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (isAdmin() && sameAcademy(academyDocId));
      allow delete: if isSuperAdmin() || (isAdmin() && sameAcademy(academyDocId));
    }

    match /classes/{classId} {
      allow read: if sameAcademy(resource.data.academyId);
      allow create: if isAcademyStaff(request.resource.data.academyId);
      allow update: if isAcademyStaff(resource.data.academyId);
      allow delete: if isAcademyStaff(resource.data.academyId);
    }

    match /class_rsvps/{rsvpId} {
      allow read: if isAcademyStaff(resource.data.academyId)
        || isSelf(resource.data.userId);

      allow create: if signedIn()
        && isStudent()
        && isSelf(request.resource.data.userId)
        && sameAcademy(request.resource.data.academyId);

      allow delete: if signedIn()
        && isSelf(resource.data.userId)
        && sameAcademy(resource.data.academyId);
    }

    match /attendances/{attendanceId} {
      allow read: if sameAcademy(resource.data.academyId)
        && (isAcademyStaff(resource.data.academyId) || isSelf(resource.data.userId));
      allow write: if false;
    }

    match /graduations/{graduationId} {
      allow read: if sameAcademy(resource.data.academyId)
        && (isAcademyStaff(resource.data.academyId) || isSelf(resource.data.userId));
      allow write: if false;
    }

    match /graduation_requests/{requestId} {
      allow read: if isSuperAdmin()
        || sameAcademy(resource.data.academyId)
        && (
          isAcademyStaff(resource.data.academyId)
          || isSelf(resource.data.userId)
        );
      allow write: if false;
    }

    match /join_requests/{requestId} {
      allow read: if isApprover() && sameAcademy(resource.data.academyId);
      allow write: if false;
    }

    match /reactivation_requests/{requestId} {
      allow read: if isSuperAdmin()
        || (isApprover() && sameAcademy(resource.data.academyId))
        || isSelf(resource.data.userId);
      allow write: if false;
    }

    match /attendance_requests/{requestId} {
      allow read: if isSuperAdmin()
        || (
          (isApprover() && sameAcademy(resource.data.academyId))
          || isSelf(resource.data.userId)
          || (isAdmin() && sameAcademy(resource.data.academyId))
        );
      allow write: if false;
    }

    match /missions/{missionId} {
      allow read: if sameAcademy(resource.data.academyId);
      allow create: if (isAdmin() && sameAcademy(request.resource.data.academyId)) || isSuperAdmin();
      allow update: if (isAdmin() && sameAcademy(resource.data.academyId)) || isSuperAdmin();
      allow delete: if (isAdmin() && sameAcademy(resource.data.academyId)) || isSuperAdmin();
    }

    match /user_missions/{userMissionId} {
      allow read: if sameAcademy(resource.data.academyId)
        && (isAcademyStaff(resource.data.academyId) || isSelf(resource.data.userId));
      allow write: if false;
    }

    match /rankings/{rankingId} {
      allow read: if sameAcademy(resource.data.academyId);
      allow write: if false;
    }

    match /competitions/{competitionId} {
      allow read: if sameAcademy(resource.data.academyId);
      allow create: if isAcademyStaff(request.resource.data.academyId) || isSuperAdmin();
      allow update: if isAcademyStaff(resource.data.academyId) || isSuperAdmin();
      allow delete: if isAcademyStaff(resource.data.academyId) || isSuperAdmin();
    }

    match /fights/{fightId} {
      allow read: if sameAcademy(resource.data.academyId);
      allow create: if isAcademyStaff(request.resource.data.academyId) || isSuperAdmin();
      allow update: if isAcademyStaff(resource.data.academyId) || isSuperAdmin();
      allow delete: if isAcademyStaff(resource.data.academyId) || isSuperAdmin();
    }

    match /fight_video_submissions/{requestId} {
      allow read: if isAcademyStaff(resource.data.academyId) || isSelf(resource.data.athleteId);
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSuperAdmin()
        || sameAcademy(resource.data.academyId)
        && (
          isAcademyStaff(resource.data.academyId)
          || isSelf(resource.data.recipientUserId)
        );

      allow create: if isAcademyStaff(request.resource.data.academyId) || isSuperAdmin();

      allow update: if isAcademyStaff(resource.data.academyId)
        || (
          isSelf(resource.data.recipientUserId)
          && request.resource.data.recipientUserId == resource.data.recipientUserId
          && request.resource.data.academyId == resource.data.academyId
          && request.resource.data.title == resource.data.title
          && request.resource.data.body == resource.data.body
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(notificationEditableKeys())
        );

      allow delete: if (isAdmin() && sameAcademy(resource.data.academyId)) || isSuperAdmin();
    }

    match /learning_tracks/{trackId} {
      allow read: if isSuperAdmin()
        || (
          signedIn()
          && isAdmin()
          && resource.data.status == 'published'
        );
      allow write: if false;
    }

    match /learning_courses/{courseId} {
      allow read: if isSuperAdmin()
        || (
          signedIn()
          && isAdmin()
          && resource.data.status == 'published'
        );
      allow write: if false;
    }

    match /learning_lessons/{lessonId} {
      allow read: if isSuperAdmin()
        || (
          signedIn()
          && isAdmin()
          && resource.data.status == 'published'
        );
      allow write: if false;
    }

    match /learning_lesson_blocks/{blockId} {
      allow read: if isSuperAdmin()
        || (
          signedIn()
          && isAdmin()
          && get(/databases/$(database)/documents/learning_lessons/$(resource.data.lessonId)).data.status == 'published'
        );
      allow write: if false;
    }

    match /learning_quizzes/{lessonId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /learning_progress/{progressId} {
      allow read: if isSuperAdmin()
        || (
          signedIn()
          && isAdmin()
          && resource.data.userId == request.auth.uid
        );
      allow write: if false;
    }

    match /learning_quiz_attempts/{attemptId} {
      allow read: if isSuperAdmin()
        || (
          signedIn()
          && isAdmin()
          && resource.data.userId == request.auth.uid
        );
      allow write: if false;
    }

    match /finance_products/{productId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /finance_services/{serviceId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /finance_sales/{saleId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /finance_sale_items/{itemId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /finance_payments/{paymentId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /finance_revenues/{revenueId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /finance_expenses/{expenseId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /inventory_movements/{movementId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
  }
}
